# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → secret key (sb_secret_...)
# atau legacy "service_role" key. JANGAN pakai anon/publishable key,
# dan jangan beri awalan NEXT_PUBLIC_ — key ini hanya boleh ada di server.
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi untuk masuk ke /admin. Pakai yang panjang dan acak.
ADMIN_PASSWORD=
